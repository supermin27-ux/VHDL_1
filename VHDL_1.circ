  <vhdl name="q1_logic4">-- VHDL_1, p.22, Problem 1: four-input AND and OR.
library ieee;
use ieee.std_logic_1164.all;

entity q1_logic4 is
    port (
        a, b, c, d : in std_logic;
        out1, out2 : out std_logic
    );
end q1_logic4;

architecture rtl of q1_logic4 is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end rtl;
</vhdl>
  <vhdl name="q2_mux8">-- VHDL_1, p.22, Problem 2: eight-to-one multiplexer.
library ieee;
use ieee.std_logic_1164.all;

entity q2_mux8 is
    port (
        a, b, c, d, e, f, g, h : in std_logic;
        sel : in std_logic_vector(2 downto 0);
        data : out std_logic
    );
end q2_mux8;

architecture rtl of q2_mux8 is
begin
    process(a, b, c, d, e, f, g, h, sel)
    begin
        case sel is
            when "000" =&gt; data &lt;= a;
            when "001" =&gt; data &lt;= b;
            when "010" =&gt; data &lt;= c;
            when "011" =&gt; data &lt;= d;
            when "100" =&gt; data &lt;= e;
            when "101" =&gt; data &lt;= f;
            when "110" =&gt; data &lt;= g;
            when "111" =&gt; data &lt;= h;
            when others =&gt; data &lt;= '0';
        end case;
    end process;
end rtl;
</vhdl>
  <vhdl name="q3_letters7seg">-- VHDL_1, p.22, Problem 3: display a, b, c, d, f, g.
-- display(7 downto 0) = a b c d e f g dp; 1 lights a segment.
-- dat: 000=a, 001=b, 010=c, 011=d, 100=f, 101=g.
library ieee;
use ieee.std_logic_1164.all;

entity q3_letters7seg is
    port (
        en : in std_logic;
        dat : in std_logic_vector(2 downto 0);
        display : out std_logic_vector(7 downto 0)
    );
end q3_letters7seg;

architecture rtl of q3_letters7seg is
begin
    process(en, dat)
    begin
        display &lt;= "00000000";
        if en = '1' then
            case dat is
                when "000" =&gt; display &lt;= "11111010"; -- a
                when "001" =&gt; display &lt;= "00111110"; -- b
                when "010" =&gt; display &lt;= "00011010"; -- c
                when "011" =&gt; display &lt;= "01111010"; -- d
                when "100" =&gt; display &lt;= "10001110"; -- f
                when "101" =&gt; display &lt;= "11110110"; -- g
                when others =&gt; display &lt;= "00000000";
            end case;
        end if;
    end process;
end rtl;
</vhdl>
  <vhdl name="q4_vote25">-- VHDL_1, p.22, Problem 4: strict majority of 25 votes.
library ieee;
use ieee.std_logic_1164.all;

entity q4_vote25 is
    port (
        vt : in std_logic_vector(24 downto 0);
        result : out std_logic
    );
end q4_vote25;

architecture rtl of q4_vote25 is
begin
    process(vt)
        variable count_ones : integer range 0 to 25;
    begin
        count_ones := 0;
        for i in vt'range loop
            if vt(i) = '1' then
                count_ones := count_ones + 1;
            end if;
        end loop;
        if count_ones &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end rtl;
</vhdl>
  <vhdl name="q5_popcount13_7seg">-- VHDL_1, p.22, Problem 5: 13-bit population count and display.
-- display(7 downto 0) = a b c d e f g dp; active high.
-- A 13-bit input reaches 0..13 (0..D). E/F remain in the decoder.
library ieee;
use ieee.std_logic_1164.all;

entity q5_popcount13_7seg is
    port (
        vt : in std_logic_vector(12 downto 0);
        en : in std_logic;
        display : out std_logic_vector(7 downto 0)
    );
end q5_popcount13_7seg;

architecture rtl of q5_popcount13_7seg is
    function hex_to_segments(value : natural) return std_logic_vector is
    begin
        case value is
            when 0  =&gt; return "11111100"; -- 0
            when 1  =&gt; return "01100000"; -- 1
            when 2  =&gt; return "11011010"; -- 2
            when 3  =&gt; return "11110010"; -- 3
            when 4  =&gt; return "01100110"; -- 4
            when 5  =&gt; return "10110110"; -- 5
            when 6  =&gt; return "10111110"; -- 6
            when 7  =&gt; return "11100000"; -- 7
            when 8  =&gt; return "11111110"; -- 8
            when 9  =&gt; return "11110110"; -- 9
            when 10 =&gt; return "11101110"; -- A
            when 11 =&gt; return "00111110"; -- b
            when 12 =&gt; return "10011100"; -- C
            when 13 =&gt; return "01111010"; -- d
            when 14 =&gt; return "10011110"; -- E
            when 15 =&gt; return "10001110"; -- F
            when others =&gt; return "00000000";
        end case;
    end hex_to_segments;
begin
    process(vt, en)
        variable count_ones : integer range 0 to 13;
    begin
        count_ones := 0;
        for i in vt'range loop
            if vt(i) = '1' then
                count_ones := count_ones + 1;
            end if;
        end loop;
        if en = '1' then
            display &lt;= hex_to_segments(count_ones);
        else
            display &lt;= "00000000";
        end if;
    end process;
end rtl;
</vhdl>
</project>
